APP_NAME=ZYW 的 AI 小助理
APP_VERSION=0.6.3
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 管理端认证；部署前请设置强密码，并为 AUTH_SECRET_KEY 生成至少 32 字节随机值
ADMIN_PASSWORD=
AUTH_SECRET_KEY=
ADMIN_TOKEN_TTL_MINUTES=480

# 阿里云百炼（北京地域公共兼容地址）
DASHSCOPE_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=22050
TTS_MAX_TEXT_CHARS=8000
TTS_CACHE_PATH=./data/tts-cache
RESUME_FILE_PATH=./output/pdf/曾有为-AI-Agent应用开发.pdf
RESUME_TITLE=曾有为｜AI Agent 应用开发
RESUME_VERSION=2026.09
RESUME_MAX_UPLOAD_BYTES=10485760
CANDIDATE_PROFILE_PATH=./data/candidate_profile.json
CHAT_MODEL=qwen3.7-plus
ROUTER_MODEL=qwen3.7-flash
SUGGESTION_MODEL=qwen3.7-flash
SUGGESTION_TIMEOUT_SECONDS=5
SUGGESTION_COUNT=3
SUGGESTION_HISTORY_MESSAGES=6
JD_MODEL_MAX_OUTPUT_TOKENS=2600
JD_EVALUATION_BATCH_SIZE=5
JD_EVIDENCE_QUOTE_CHARS=350
MODEL_ENABLE_THINKING=false
MODEL_MAX_OUTPUT_TOKENS=1200
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=20
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
DOCUMENTS_PATH=./data/documents
CHROMA_COLLECTION=personal_knowledge_base
MAX_UPLOAD_BYTES=31457280
MAX_FILENAME_LENGTH=255
CHUNK_SIZE=800
CHUNK_OVERLAP=120
INGESTION_MAX_ATTEMPTS=3
RAG_TOP_K=5
RAG_FETCH_K=20
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_HISTORY_MESSAGES=6
AGENT_MAX_STEPS=8
AGENT_MAX_RETRIEVAL_ATTEMPTS=2
CAREER_AGENT_MAX_STEPS=6
CAREER_AGENT_TIMEOUT_SECONDS=20
AGENT_TIMEOUT_SECONDS=90
